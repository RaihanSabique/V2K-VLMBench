# documents (lab protocol; the findings report embeds participant frames).
data/
outputs/
documents/
*.c3d

# Stray media / arrays anywhere else
*.mp4
*.mov
*.MOV
*.avi
*.mkv
*.gif
*.npz
*.npy

# ...except the README demo media
!docs/media/
!docs/media/*.mp4
!docs/media/*.gif

# --- Job logs -----------------------------------------------------------------
slurm/*.out
*.log
