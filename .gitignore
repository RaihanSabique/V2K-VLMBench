# --- Environment and caches ---------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.vscode/
.DS_Store

# --- Large files: model weights and third-party code (see README "Installation")
models/
third_party/
*.safetensors
*.onnx
*.onnx.data
*.data
